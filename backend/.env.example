# Copy this file to .env and replace the placeholder with your own password.
# URL-encode the password if it contains characters such as @, :, /, ?, #, or %.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/orbit
# Supabase project URL, for example https://your-project.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Add deployed frontend URLs here too, separated by commas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
